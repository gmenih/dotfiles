#!/usr/bin/env bash
#
# UserPromptSubmit hook: name the orchestrator's tab.
#
# "Directory is context" (CLAUDE.md): standing outside any git repository -
# home, ~/Work/Pump, a scratch dir - means this session is the orchestrator.
# Its job is to route work into worktrees rather than type it out. A tab doing
# that job should say so: herdr's tab bar is the only place you can see, at a
# glance, which of a dozen sessions is the one holding the threads.
#
# A repo root and a *.trees worktree are both "inside a repo". Those tabs
# belong to a project or a task and are named from elsewhere (mn labels a task
# tab after the task), so they are left alone.
#
# Fires on every prompt but does work at most once per tab: after the rename
# the tab has a name, and a named tab is never touched. Unnamed is detectable
# because herdr labels a fresh tab with its own number - label "1" on tab
# number 1. Anything that names it makes the two diverge.
#
# Always exits 0. A cosmetic rename must never interfere with a prompt.

set -uo pipefail

# Only meaningful inside herdr, and only when we know which tab we are.
[[ -n "${HERDR_TAB_ID:-}" ]] || exit 0
command -v herdr >/dev/null 2>&1 || exit 0
command -v jq    >/dev/null 2>&1 || exit 0

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)
[[ -n "$cwd" && -d "$cwd" ]] || cwd=$PWD

# Inside a git repository (root, subdir, or linked worktree)? Not our case.
git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 && exit 0

# Only name a tab that has no name yet.
unnamed=$(herdr tab list 2>/dev/null |
  jq -r --arg id "$HERDR_TAB_ID" '
    .result.tabs[]? | select(.tab_id == $id) | (.label == (.number | tostring))
  ' 2>/dev/null)
[[ "$unnamed" == "true" ]] || exit 0

herdr tab rename "$HERDR_TAB_ID" orc >/dev/null 2>&1
exit 0
